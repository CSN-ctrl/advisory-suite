# Copy to ".env" for local API + Vite (never commit .env).
# Vercel: add the same keys in Project → Settings → Environment Variables.

# --- Supabase (project URL from Dashboard → Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public key: "anon" JWT or publishable key (used by /api/content reads).
SUPABASE_ANON_KEY=
# Optional if you use the new publishable key instead of anon JWT:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only: service_role JWT — never expose to the browser or VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# Vite (browser-safe only). Optional if the client talks to Supabase directly.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Admin ---
# Username + password (Express + Vercel /api/admin/*).
ADMIN_USERNAME=admin
# Plain password (min 8 characters in login form). Only used if ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=
# Or use bcrypt instead of plain password (recommended for production):
# ADMIN_PASSWORD_HASH=
# Optional: cookie signing secret. If omitted, signing key is derived from SUPABASE_SERVICE_ROLE_KEY
# (rotating that key logs everyone out). Set this for a dedicated session secret.
# ADMIN_SESSION_SECRET=

# Local API port (Vite proxies /api here in dev).
API_PORT=8787
