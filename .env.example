# =============================================================================
# Single source of truth: copy to ".env" at the repo root (never commit .env).
# Vercel: use the same variable names under Settings → Environment Variables.
#
# Local: `npm run dev` is enough for the app (Supabase in the browser).
# Optional: `npm run dev:full` also starts a tiny API (`/api/health` only).
# Or run `npm run api` in one terminal and `npm run dev` in another.
#
# Database: apply SQL in supabase/migrations/ (e.g. Supabase Dashboard → SQL
# Editor, or `supabase db push`). Then optionally migrate old JSON:
#   node scripts/migrate-local-bookings-to-supabase.mjs
# =============================================================================

# --- Local dev servers ---
# Port for `npm run dev` (Vite). Default 8080 if unset.


# --- Supabase (Dashboard → Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional: direct Postgres URI for `npm run db:apply:site-pages` (Dashboard → Database → Connection string).
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Vite / browser (never put service_role here).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Admin (Supabase Auth + RLS + rpc) ---
# The UI calls PostgREST `rpc('is_admin')` (see migration). Grant admin by:
#   (A) Auth app or user raw metadata: {"admin": true}, and/or
#   (B) INSERT into public.admin_email_allowlist (SQL) lowercase emails.
# Optional (Vercel serverless admin routes only): comma emails for Bearer verify.
# ADMIN_SUPABASE_ALLOWLIST=you@example.com

# --- Booking confirmation email ---
# Disabled in the app for now (bookings are saved in Supabase only).
# To enable later: wire `src/lib/availability-store.ts` → POST /api/bookings/notify
# and restore the route in `server/index.js` using `server/booking-email.mjs`.
